# BFT-SMaRt system configuration for the Tailored BFT VDR.
#
# The settings the build plan fixes (§4) are marked. Every run archives this file alongside its
# results: a consensus configuration that is not recorded makes two runs incomparable.
#
# NOTE ON KEYS. defaultkeys=false: every process loads its own RSA pair from config/keys/
# (privatekey<id>, publickey<id>), generated with BFT-SMaRt 1.2's RSAKeyPairGenerator, 2048-bit,
# for replica ids 0-9. Replica-to-replica channels run a Diffie-Hellman exchange signed with these
# keys, which is what makes them mutually authenticated (Paper 2 §III). defaultkeys=true would give
# every replica the same publicly known demo key and void that claim.
#
# Scope: in 1.2 the client-to-replica MAC key is derived from "<clientId>:<replicaId>" alone, so
# these keys do not authenticate client channels. That takes useSignatures = 1 plus a key pair
# per client id.
#
# Private keys never leave the machine they were made on (.gitignore, .dockerignore). On a new
# machine, from the repo root:  ./vdr-bftsmart/gen-keys.sh   (ids 0..servers.num-1; FORCE=1 to
# regenerate). run-protocol.sh tailored-bft and real-gates.sh refuse to start without them.

############################################
###### Consensus (plan §4) #################
############################################

# n = 3f+1. Sweep 4 / 7 / 10 for f = 1 / 2 / 3 (Paper 2's scalability sweep).
system.servers.num = 4
system.servers.f = 1

# 0 = client requests carry MACs only; 1 = clients sign requests (slower). At 0 the client MAC key
# in 1.2 has no secret input (see NOTE ON KEYS), so client channels are unauthenticated. 1 is the
# honest setting for a Byzantine threat model, and it needs a key pair per client id in keys/.
system.communication.useSignatures = 0

# Keep signature verification off the ordering thread.
system.communication.useSenderThread = true

# Per-replica keys from config/keys/: see the note above. Never true for a reported run.
system.communication.defaultkeys = false

############################################
###### Batching (DepSpace batch agreement) #
############################################

# One consensus instance orders a BATCH, which is what makes a revocation burst bounded by batch
# size rather than by consensus round count. Swept; report the operating point.
system.totalordermulticast.maxbatchsize = 400
system.totalordermulticast.timeout = 2000

############################################
###### State transfer and checkpoints ######
############################################

# Needed for the snapshot obligations: a recovering replica catches up from a checkpoint rather
# than replaying from genesis. This is BFT-SMaRt's OWN checkpoint period, which is a different
# thing from the Merkle checkpoint interval the read proofs are cut against
# (-Dvdr.checkpointInterval, swept over {1k, 5k, 20k} in plan §4).
system.totalordermulticast.state_transfer = true
system.totalordermulticast.checkpoint_period = 1000
system.totalordermulticast.log = true
system.totalordermulticast.log_parallel = false
system.totalordermulticast.log_to_disk = false
system.totalordermulticast.sync_log = false
system.totalordermulticast.global_checkpoint_period = 4000

############################################
###### Client and view #####################
############################################

system.initial.view = 0,1,2,3
system.ttp.id = 7002
system.communication.inQueueSize = 500000
system.communication.outQueueSize = 500000
system.numrepliers = 4
system.numnnies = 0

# Durability: off for the benchmark image so the measurement is of consensus and execution, not of
# fsync. State this in the results; a durable run is a separate configuration.
system.bft = true
