# BFT-SMaRt host table: replica id, address, consensus port, (optional) client port.
#
# n = 4, f = 1. The addresses below are the container names in deploy/vps/docker-compose.yml, so
# one file serves both the cluster and the benchmark client. For a multi-host run (the final
# evaluation places replicas on separate machines) replace them with real hostnames; nothing else
# changes.
#
# 7- and 10-replica rows for the scalability sweep are commented out. Uncomment the ones you need
# and set system.servers.num / system.servers.f to match.

0 vdr-replica-0 11000 11001
1 vdr-replica-1 11010 11011
2 vdr-replica-2 11020 11021
3 vdr-replica-3 11030 11031

#4 vdr-replica-4 11040 11041
#5 vdr-replica-5 11050 11051
#6 vdr-replica-6 11060 11061
#7 vdr-replica-7 11070 11071
#8 vdr-replica-8 11080 11081
#9 vdr-replica-9 11090 11091

# The client id range. Clients take ids from vdr.clientIdBase (default 1001) upward, one per
# proxy, and must not collide with replica ids.
7777 127.0.0.1 11100
